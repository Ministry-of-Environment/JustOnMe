  m_Name: SickDeath
  m_EditorClassIdentifier: Assembly-CSharp::EndingData
  endingType: 1
  title: A Slow Illness
  description: 'You survived.

    

    But the polluted air and water slowly
    settled inside your body.

    The cost of enduring each day only revealed itself
    much later.

    

    The city did not collapse.

    But you eventually
    faded away within it.'
  endingImage: {fileID: 0}
