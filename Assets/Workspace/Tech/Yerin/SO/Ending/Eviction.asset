  m_Script: {fileID: 11500000, guid: 313dd21b461980a41b9b1b64dbe17228, type: 3}
  m_Name: Eviction
  m_EditorClassIdentifier: Assembly-CSharp::EndingData
  endingType: 4
  title: A Night Outside
  description: 'You failed to pay the rent.

    

    The door was locked, and
    your belongings were left on the cold street.

    Without a place to return
    to, even tomorrow became uncertain.

    

    Your survival ended not in the
    sea,

    but outside the home you could no longer keep.'
  endingImage: {fileID: 0}
